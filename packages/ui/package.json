  "description": "Nooxit design system: shadcn/ui components (Radix) styled with the Nooxit design tokens.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.13.3",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "next-themes": "^0.4.6"
  },
  "peerDependencies": {
    "next-themes": ">=0.4",
    "react": "^19",
    "react-dom": "^19"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./tokens": "./src/tokens.ts",
    "./globals.css": "./src/styles/globals.css",
    "./theme.css": "./src/styles/theme.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./postcss.config": "./postcss.config.mjs"
  }
}
